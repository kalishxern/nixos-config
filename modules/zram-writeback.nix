{config,pkgs,...}:{systemd.services.zram-writeback-psi={description="Zram writeback triggered by PSI memory pressure";after=["zram-custom.service"];wants=["zram-custom.service"];wantedBy=["multi-user.target"];serviceConfig={Type="simple";ExecStart="${pkgs.python3}/bin/python3 ${./../scripts/zram-wb-psi.py}";Environment=["ZRAM_WB_HOT_RELOAD_PATH=/run/zram-wb/tunables.conf" "ZRAM_WB_METRICS_PATH=/run/zram-wb/metrics.prom" "ZRAM_WB_PSI_TRIGGER=\"some 150000 1000000\"" "ZRAM_WB_ZRAM_DEV=zram0" "ZRAM_WB_IDLE_MARK_SEC=1.5" "ZRAM_WB_INTERVAL_SEC=15.0" "ZRAM_WB_IDLE_AGE_SEC=180.0" "ZRAM_WB_BURST=2" "ZRAM_WB_POLL_TIMEOUT_MS=2000" "ZRAM_WB_LOG_LEVEL=INFO" "ZRAM_WB_RECOMP_ENABLE=1" "ZRAM_WB_RECOMP_ALGO=zstd" "ZRAM_WB_RECOMP_MAX_PAGES=65536" "ZRAM_WB_LIMIT_MB=6000"];RuntimeDirectory="zram-wb";RuntimeDirectoryPreserve="restart";Restart="always";RestartSec="5s";Nice=19;IOSchedulingClass="idle";NoNewPrivileges=true;ProtectHome=true;ProtectSystem="strict";PrivateTmp=true;};};}
